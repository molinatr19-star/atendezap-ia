# Copie para .env e preencha (o CLI do Prisma lê .env). Nunca versione o .env real.

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AtendeZap IA"

# Banco de dados: SQLite local via Prisma (ADR 0004)
DATABASE_URL="file:./prisma/dev.db"

# Autenticação (definir após escolha do provedor)
AUTH_SECRET=

# IA — Claude API (somente servidor)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1024

# WhatsApp Cloud API (Meta)
# mock = respostas simuladas, sem número real | cloud = API oficial
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
