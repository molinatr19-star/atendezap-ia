# Copie para .env e preencha (o CLI do Prisma lê .env). Nunca versione o .env real.

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AtendeZap IA"

# Banco de dados: PostgreSQL local via Docker Compose (ADR 0005). Rode: docker compose up -d
DATABASE_URL="postgresql://atendezap:atendezap_local@localhost:5432/atendezap?schema=public"
# Banco dos testes automatizados (apagado e recriado pelos testes)
TEST_DATABASE_URL="postgresql://atendezap:atendezap_local@localhost:5432/atendezap_test?schema=public"

# Autenticação (Better Auth, ADR 0006). Gere o segredo: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# IA — Claude API (somente servidor)
ANTHROPIC_API_KEY=
# Sem chave, o agente usa o motor simulado (gratuito). Chave em console.anthropic.com (formato sk-ant-...)
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (chat de atendimento: low)
AI_EFFORT=low
AI_MAX_TOKENS=16000

# WhatsApp Cloud API (Meta)
# mock = respostas simuladas, sem número real | cloud = API oficial
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
