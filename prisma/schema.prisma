// Schema do AtendeZap IA (Prisma ORM 7 + PostgreSQL).
// Modelo conceitual em docs/modelo-de-dados.md. Toda entidade de negócio carrega workspaceId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// No PostgreSQL os enums são tipos nativos: o próprio banco rejeita valores inválidos.
enum ConversationStatus {
  open
  pending
  resolved
}

enum Assignee {
  ai
  human
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  contact
  ai
  user
}

enum DeliveryStatus {
  sent
  delivered
  read
  failed
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  contacts       Contact[]
  tags           Tag[]
  conversations  Conversation[]
  pipelineStages PipelineStage[]
  leads          Lead[]
  attendances    Attendance[]
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// Telefone em E.164 (ex.: +5511900000001).
  phoneE164   String
  city        String?
  optIn       Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags          Tag[]
  conversations Conversation[]
  leads         Lead[]

  @@unique([workspaceId, phoneE164])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@unique([workspaceId, name])
}

model Conversation {
  id               String             @id @default(cuid())
  workspaceId      String
  contactId        String
  status           ConversationStatus @default(open)
  assignee         Assignee           @default(ai)
  assignedUserName String?
  unreadCount      Int                @default(0)
  /// Motivo registrado quando a IA transfere para a equipe.
  handoffReason    String?
  lastMessageAt    DateTime
  /// Base da janela de 24 h do WhatsApp.
  lastInboundAt    DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages   Message[]
  attendance Attendance?

  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  /// Id da mensagem no WhatsApp: único, garante idempotência do webhook.
  externalId     String?          @unique
  direction      MessageDirection
  author         MessageAuthor
  content        String
  deliveryStatus DeliveryStatus?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PipelineStage {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  /// Posição da coluna no Kanban.
  position    Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, position])
}

model Lead {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  stageId     String
  /// Valor estimado em centavos (evita erro de arredondamento com dinheiro).
  valueCents  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id])

  @@index([workspaceId, stageId])
}

/// Atendimento encerrado: base das métricas do dashboard.
/// Registros históricos do seed não têm conversa vinculada.
model Attendance {
  id                   String   @id @default(cuid())
  workspaceId          String
  conversationId       String?  @unique
  startedAt            DateTime
  resolvedAt           DateTime
  resolvedBy           Assignee
  firstResponseSeconds Int
  leadCreated          Boolean  @default(false)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
}
